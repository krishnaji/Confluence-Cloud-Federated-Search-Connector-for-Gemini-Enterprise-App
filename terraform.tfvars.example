# ------------------------------------------------------------------------------
# Required Google Cloud Project Configuration
# ------------------------------------------------------------------------------
project_id              = "your-gcp-project-id"
location                = "us" # 'global', 'us', or 'eu'
collection_id           = "confluence-federated-us"
collection_display_name = "Confluence Cloud Federated Search US"

# ------------------------------------------------------------------------------
# Required Confluence Cloud & OAuth Credentials
# ------------------------------------------------------------------------------
confluence_instance_uri = "https://your-domain.atlassian.net"
instance_id             = "your-instance-id" # Atlassian cloudId from https://<domain>.atlassian.net/_edge/tenant_info

client_id     = "your-atlassian-oauth-client-id"
client_secret = "your-atlassian-oauth-client-secret"

# ------------------------------------------------------------------------------
# Optional Configuration (Uncomment to override defaults in variables.tf)
# ------------------------------------------------------------------------------
# connector_modes      = ["FEDERATED"]
# enable_actions        = false
# enabled_actions_list  = ["create_comment", "update_comment"]

# ------------------------------------------------------------------------------
# Slack Federated Search Configuration
# ------------------------------------------------------------------------------
slack_collection_id           = "slack-federated-us"
slack_collection_display_name = "Slack Federated Search US"
# slack_team_id               = "T01234567" # Optional Slack Workspace Team ID
# slack_static_ip_enabled     = false
# slack_enable_actions        = false
# slack_enabled_actions_list  = ["send_message"]

# ------------------------------------------------------------------------------
# PagerDuty Federated Search Configuration
# ------------------------------------------------------------------------------
pagerduty_collection_id           = "pagerduty-federated-1"
pagerduty_collection_display_name = "PagerDuty Federated Search"
pagerduty_client_id               = "your-pagerduty-oauth-client-id"
pagerduty_client_secret           = "your-pagerduty-oauth-client-secret"
# pagerduty_static_ip_enabled     = false

# ------------------------------------------------------------------------------
# Jira Federated Search Configuration
# ------------------------------------------------------------------------------
jira_collection_id           = "jira-federated-1"
jira_collection_display_name = "Jira Federated Search"
jira_instance_uri            = "https://your-domain.atlassian.net"
jira_instance_id             = "your-atlassian-cloud-id"
jira_client_id               = "your-atlassian-jira-oauth-client-id"
jira_client_secret           = "your-atlassian-jira-oauth-client-secret"
# jira_static_ip_enabled      = false



